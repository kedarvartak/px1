      "id": "scm-provider-contract",
      "path": "internal/hosted/scm/provider.go",
      "lineStart": 12,
      "lineEnd": 45,
      "title": "Introduces an SCM provider boundary",
      "summary": "Adds a provider-neutral interface for retrieving diffs and files, managing review comments and status, and verifying webhooks. Callers can use these capabilities without depending directly on GitHub-specific operations."
    },
    {
      "id": "scm-input-validation",
      "path": "internal/hosted/scm/provider.go",
      "lineStart": 47,
      "lineEnd": 139,
      "title": "Validates requests before delegation",
      "summary": "The GitHub adapter rejects calls with missing operations, invalid repository or pull-request details, or missing summary/status fields before delegating. Webhook verification likewise requires a body, delivery ID, and signature, preventing incomplete inputs from reaching the backend."
    }
