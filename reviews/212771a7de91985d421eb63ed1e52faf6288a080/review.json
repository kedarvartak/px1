      "path": "internal/hosted/repository/clone.go",
      "lineStart": 39,
      "lineEnd": 79,
      "title": "Bounds clone duration and supports cleanup",
      "summary": "Each clone has a configurable timeout (two minutes by default). Failed clones remove their temporary directory, while successful clones expose a Remove method to dispose of it."
    },
    {
      "id": "restricted-clone",
      "path": "internal/hosted/repository/clone.go",
      "lineStart": 55,
      "lineEnd": 74,
      "title": "Limits clone contents and Git behavior",
      "summary": "Accepted repositories are fetched as bare, depth-one, single-branch clones with tags omitted and large blobs filtered. Git’s file and ext transports and credential helper are disabled, and the process runs without system or interactive prompt configuration."
    },
    {
      "id": "repository-host-restrictions",
      "path": "internal/hosted/repository/clone.go",
      "lineStart": 80,
      "lineEnd": 99,
      "title": "Rejects untrusted repository URLs",
      "summary": "Cloning is limited to HTTPS URLs on explicitly allowed hosts (GitHub by default); URLs containing credentials, query parameters, or fragments are rejected before a temporary directory is created."
    }
  ],
