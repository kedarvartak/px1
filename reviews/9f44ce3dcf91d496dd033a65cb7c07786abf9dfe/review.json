      "path": "internal/hosted/graph/overlay.go",
      "lineStart": 91,
      "lineEnd": 137,
      "title": "Report symbol changes",
      "summary": "Reports symbols as added, removed, or modified by matching path, kind, and name; a change to signature or line range counts as a modification."
