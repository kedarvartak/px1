      "id": "input-validation",
      "path": "internal/hosted/graph/overlay.go",
      "lineStart": 56,
      "lineEnd": 119,
      "title": "Reject invalid overlay inputs",
      "summary": "Rejects missing parser or file identity data, duplicate changed paths, parser failures, and invalid parsed symbols or edges instead of returning a partial overlay."
    },
